uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d depth_map;

uniform float2 texel;
uniform float max_radius;
uniform float focus_depth;
uniform float focus_range;
uniform float edge_sensitivity;
uniform float mix_amount;

sampler_state texSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

sampler_state depthSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData v_out;
	v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	v_out.uv  = v_in.uv;
	return v_out;
}

float coc_from_depth(float d)
{
	float dist = abs(d - focus_depth);
	float denom = 1.0 - focus_range;
	if (denom < 0.0001)
		denom = 0.0001;
	float t = saturate((dist - focus_range) / denom);
	return t * t * max_radius;
}

float sample_depth_guided(float2 uv, float ref)
{
	float d0 = depth_map.Sample(depthSampler, uv).r;
	float2 s = texel * 1.5;

	float d1 = depth_map.Sample(depthSampler, uv + float2( s.x, 0.0)).r;
	float d2 = depth_map.Sample(depthSampler, uv + float2(-s.x, 0.0)).r;
	float d3 = depth_map.Sample(depthSampler, uv + float2(0.0,  s.y)).r;
	float d4 = depth_map.Sample(depthSampler, uv + float2(0.0, -s.y)).r;

	float best = d0;
	float bestd = abs(d0 - ref);

	if (abs(d1 - ref) < bestd) { best = d1; bestd = abs(d1 - ref); }
	if (abs(d2 - ref) < bestd) { best = d2; bestd = abs(d2 - ref); }
	if (abs(d3 - ref) < bestd) { best = d3; bestd = abs(d3 - ref); }
	if (abs(d4 - ref) < bestd) { best = d4; }

	return best;
}

float4 PSBokeh(VertData v_in) : TARGET
{
	float4 center = image.Sample(texSampler, v_in.uv);
	float dc = depth_map.Sample(depthSampler, v_in.uv).r;
	dc = sample_depth_guided(v_in.uv, dc);

	float coc_c = coc_from_depth(dc);

	if (coc_c < 0.6)
		return center;
	if (mix_amount < 0.001)
		return center;

	float3 acc = center.rgb;
	float wsum = 1.0;

	int i;
	for (i = 1; i <= 40; i++) {
		float t = (float)i / 40.0;
		float r = sqrt(t) * coc_c;
		float a = (float)i * 2.39996323;

		float2 uv = v_in.uv + float2(cos(a), sin(a)) * r * texel;

		float ds = depth_map.Sample(depthSampler, uv).r;
		float3 cs = image.Sample(texSampler, uv).rgb;

		float coc_s = coc_from_depth(ds);

		float occl = 1.0 - saturate((ds - dc) * edge_sensitivity);

		float rr = r;
		if (rr < 0.001)
			rr = 0.001;
		float w = saturate(coc_s / rr) * occl;

		float lum = dot(cs, float3(0.299, 0.587, 0.114));
		w = w * (1.0 + lum * lum * 0.75);

		acc = acc + cs * w;
		wsum = wsum + w;
	}

	if (wsum < 0.0001)
		wsum = 0.0001;

	float3 blurred = acc / wsum;
	return float4(lerp(center.rgb, blurred, mix_amount), center.a);
}

float4 PSDepth(VertData v_in) : TARGET
{
	float d = depth_map.Sample(depthSampler, v_in.uv).r;
	return float4(d, d, d, 1.0);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSBokeh(v_in);
	}
}

technique DrawDepth
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSDepth(v_in);
	}
}
